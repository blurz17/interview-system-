# CareerPilot Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# Do NOT commit sensitive keys to source control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=CareerPilot
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16+)
# Local Windows PostgreSQL example: postgresql+asyncpg://postgres:your_password@localhost:5432/careerpilot
# Docker Compose example: postgresql+asyncpg://careerpilot:careerpilot@postgres:5432/careerpilot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot
DATABASE_TEST_URL=sqlite+aiosqlite:///:memory:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security and Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Judge0 Code Execution
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_MEMORY_LIMIT_KB=256000
JUDGE0_CPU_TIME_LIMIT_SECONDS=5

# AI Provider Configuration (Hugging Face Inference Providers, etc.)
LLM_PROVIDER=huggingface
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_API_BASE_URL=https://api-inference.huggingface.co/models
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2048
AI_DAILY_USER_LIMIT=50

# Embedding Provider
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Speech-to-Text & Text-to-Speech
SPEECH_PROVIDER=huggingface
SPEECH_API_KEY=
SPEECH_MODEL=openai/whisper-large-v3-turbo
TTS_PROVIDER=web_speech_api
TTS_API_KEY=
TTS_MODEL=
