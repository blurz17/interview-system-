# CareerPilot Backend Production Configuration Template
# Configure these variables in Heroku > Settings > Config Vars

# General Application Settings
ENVIRONMENT=production
DEBUG=false
APP_NAME=CareerPilot
APP_VERSION=1.0.0

# CORS & Frontend Origins (Replace with your actual Vercel domain)
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGINS=https://your-frontend-app.vercel.app

# Database (Neon Serverless PostgreSQL with asyncpg driver and SSL)
# Must start with postgresql+asyncpg:// and end with ?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/careerpilot?ssl=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=generate_a_secure_64_char_hex_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (Persists in Neon PostgreSQL)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# AI Provider (Google Gemini 2.5 Flash for dynamic interviews & job matching)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_from_google_ai_studio
LLM_MODEL=gemini-2.5-flash
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2048
AI_DAILY_USER_LIMIT=50

# Sandboxed Code Execution
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_MOCK_FALLBACK=true
